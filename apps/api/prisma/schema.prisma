generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prompt {
  id          String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String          @db.VarChar(160)
  description String          @default("") @db.VarChar(1000)
  content     String          @db.Text
  isFavorite  Boolean         @default(false)
  categoryId  String?         @db.Uuid
  category    Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags        PromptTag[]
  versions    PromptVersion[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @default(now()) @updatedAt

  @@index([name])
  @@index([categoryId])
  @@index([isFavorite])
  @@map("prompts")
}

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String   @default("") @db.VarChar(500)
  prompts     Prompt[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  @@map("categories")
}

model Tag {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String      @unique @db.VarChar(80)
  color     String      @default("#3b82f6") @db.VarChar(32)
  prompts   PromptTag[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @default(now()) @updatedAt

  @@map("tags")
}

model PromptTag {
  promptId   String   @db.Uuid
  tagId      String   @db.Uuid
  assignedAt DateTime @default(now())
  prompt     Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([promptId, tagId])
  @@index([tagId])
  @@map("prompt_tags")
}

model PromptVersion {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  promptId     String   @db.Uuid
  version      Int
  name         String   @db.VarChar(160)
  description  String   @default("") @db.VarChar(1000)
  content      String   @db.Text
  isFavorite   Boolean  @default(false)
  categoryId   String?  @db.Uuid
  categoryName String?  @db.VarChar(80)
  tagIds       String[] @default([])
  tagNames     String[] @default([])
  createdAt    DateTime @default(now())
  prompt       Prompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)

  @@unique([promptId, version])
  @@index([promptId])
  @@map("prompt_versions")
}

model Solution {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(200)
  summary     String       @default("") @db.VarChar(500)
  content     String       @db.Text
  category    String       @default("") @db.VarChar(80)
  tags        String[]     @default([])
  isFavorite   Boolean      @default(false)
  annotations Annotation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([title])
  @@index([category])
  @@map("solutions")
}

model Note {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(200)
  summary     String       @default("") @db.VarChar(500)
  content     String       @db.Text
  category    String       @default("") @db.VarChar(80)
  tags        String[]     @default([])
  isFavorite   Boolean      @default(false)
  annotations Annotation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([title])
  @@index([category])
  @@map("notes")
}

model Miscellany {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String       @db.VarChar(200)
  summary     String       @default("") @db.VarChar(500)
  content     String       @db.Text
  category    String       @default("") @db.VarChar(80)
  tags        String[]     @default([])
  isFavorite   Boolean      @default(false)
  annotations Annotation[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  @@index([title])
  @@index([category])
  @@map("miscellanies")
}

model ModelResponse {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String       @db.VarChar(200)
  summary       String       @default("") @db.VarChar(500)
  content       String       @db.Text
  category      String       @default("") @db.VarChar(80)
  tags          String[]     @default([])
  sourceProduct String       @default("") @db.VarChar(120)
  modelName     String       @default("") @db.VarChar(120)
  originalPrompt String      @default("") @db.Text
  isFavorite   Boolean      @default(false)
  annotations   Annotation[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now()) @updatedAt

  @@index([title])
  @@index([category])
  @@map("model_responses")
}

model UiPrototype {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title         String   @db.VarChar(160)
  summary       String   @default("") @db.VarChar(500)
  html          String   @db.Text
  category      String   @default("") @db.VarChar(80)
  tags          String[] @default([])
  allowExternal Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([title])
  @@index([category])
  @@map("ui_prototypes")
}

model MarkdownImagePolicy {
  id           String   @id @db.VarChar(32)
  allowedHosts String[] @default([])
  version      Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("markdown_image_policies")
}

enum AnnotationResourceType {
  NOTE
  SOLUTION
  MISCELLANY
  MODEL_RESPONSE
}

model Annotation {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resourceType      AnnotationResourceType
  noteId            String?                @db.Uuid
  note              Note?                  @relation(fields: [noteId], references: [id], onDelete: Cascade)
  solutionId        String?                @db.Uuid
  solution          Solution?              @relation(fields: [solutionId], references: [id], onDelete: Cascade)
  miscellanyId      String?                @db.Uuid
  miscellany        Miscellany?            @relation(fields: [miscellanyId], references: [id], onDelete: Cascade)
  modelResponseId   String?                @db.Uuid
  modelResponse     ModelResponse?         @relation(fields: [modelResponseId], references: [id], onDelete: Cascade)
  content           String                 @db.Text
  exact             String                 @db.Text
  prefix            String                 @default("") @db.VarChar(500)
  suffix            String                 @default("") @db.VarChar(500)
  start             Int
  end               Int
  documentUpdatedAt DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  @@index([noteId])
  @@index([solutionId])
  @@index([miscellanyId])
  @@index([modelResponseId])
  @@index([resourceType, createdAt])
  @@map("annotations")
}

// SKILL 版本是完整快照，原包与文件列表跟随资源级联删除。
model Skill {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  name        String         @db.VarChar(200)
  description String         @db.VarChar(500)
  versions    SkillVersion[]
  variants    SkillVariant[]

  @@map("skills")
}

model SkillVariant {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId   String         @db.Uuid
  skill     Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)
  toolKey   String         @db.VarChar(32)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  versions  SkillVersion[]

  @@unique([skillId, toolKey])
  @@unique([id, skillId])
  @@map("skill_variants")
}

model SkillVersion {
  id                 String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  skillId            String       @db.Uuid
  skill              Skill        @relation(fields: [skillId], references: [id], onDelete: Cascade)
  variantId          String       @db.Uuid
  variant            SkillVariant @relation(fields: [variantId, skillId], references: [id, skillId], onDelete: Cascade)
  number             Int
  name               String       @db.VarChar(200)
  description        String       @db.VarChar(500)
  note               String       @db.VarChar(500)
  format             String       @db.VarChar(8)
  originalName       String       @db.VarChar(255)
  contentHash        String       @db.VarChar(64)
  artifactHash       String       @db.VarChar(64)
  artifact           Bytes
  requestId          String       @unique @db.Uuid
  requestFingerprint String?      @db.VarChar(64)
  createdAt          DateTime     @default(now())
  files              SkillFile[]

  @@unique([variantId, number])
  @@map("skill_versions")
}

model SkillFile {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  versionId String       @db.Uuid
  version   SkillVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  path      String       @db.Text
  size      Int
  hash      String       @db.VarChar(64)
  text      String?      @db.Text

  @@unique([versionId, path])
  @@map("skill_files")
}
