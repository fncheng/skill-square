POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=prompt_skill_manager
POSTGRES_PORT=5432
IMAGE_TAG=latest
CORS_ORIGIN=http://localhost:5173
WEB_PORT=5173

# 使用 bcrypt 12 轮哈希，禁止填写明文密码。
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash
# 至少 32 个字符；生产环境建议使用 openssl rand -base64 48 生成。
AUTH_JWT_SECRET=replace_with_a_random_secret_at_least_32_chars
AUTH_SESSION_TTL_SECONDS=28800
# 本地 HTTP 使用 false；生产 HTTPS 必须改为 true。
AUTH_COOKIE_SECURE=false

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prompt_skill_manager?schema=public
VITE_API_BASE_URL=http://localhost:3000/api
